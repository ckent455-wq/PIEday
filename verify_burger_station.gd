extends SceneTree
func _initialize(): call_deferred("check")
func check():
 root.set_meta("pie_day_wallet", preload("res://earnings.gd").new(false))
 var game = load("res://main.tscn").instantiate()
 root.add_child(game)
 current_scene = game
 await process_frame
 await physics_frame
 game.set_physics_process(false)
 var shift = game.shift
 shift.set_process(false)
 var station = shift.burger_station
 station.use("burger_raw")
 assert(shift.carried_item.is_empty(),"Raw patties are unavailable during opening prep")
 shift.donut_fryer.stock = [6,6,6]
 assert(not shift.start_shift() and not station.tomato_ingredients.visible, "Opening requires tomato stock")
 var box = station.get_node("freezer_tomato")
 var eye := Vector3(9.2, 2.0, -9.75)
 assert(game.interaction_at(eye, eye.direction_to(box.global_position)).action == box, "Tomato box can be reached from the freezer aisle")
 shift.interact(box)
 assert(shift.carried_item == station.TOMATO_STOCK and not shift.place_carried())
 shift.discard_last()
 shift.interact(box)
 shift.interact(station.get_node("TomatoBin"))
 assert(shift.carried_item.is_empty() and station.tomatoes_stocked and station.tomato_ingredients.visible)
 assert(not shift.start_shift() and not station.onion_ingredients.visible, "Opening also requires onion stock")
 var onion_box = station.get_node("freezer_onion")
 var onion_eye := Vector3(9.2, 2.0, -8.77)
 assert(game.interaction_at(onion_eye, onion_eye.direction_to(onion_box.global_position)).action == onion_box, "Onion box can be reached from the freezer aisle")
 shift.interact(onion_box)
 shift.interact(station.get_node("TomatoBin"))
 assert(shift.carried_item == station.ONION_STOCK and not station.onions_stocked)
 shift.interact(station.get_node("OnionBin"))
 assert(shift.carried_item.is_empty() and station.onions_stocked and station.onion_ingredients.visible)
 assert(not shift.start_shift() and not station.lettuce_ingredients.visible, "Opening also requires lettuce stock")
 var lettuce_box = station.get_node("freezer_lettuce")
 var lettuce_eye := Vector3(9.5, 2.0, -8.25)
 assert(game.interaction_at(lettuce_eye, lettuce_eye.direction_to(lettuce_box.global_position)).action == lettuce_box, "Lettuce box can be reached from the freezer aisle")
 shift.interact(lettuce_box)
 shift.interact(station.get_node("LettuceBin"))
 assert(shift.carried_item.is_empty() and station.lettuce_stocked and station.lettuce_ingredients.visible)
 assert(not shift.start_shift() and not station.cheese_ingredients.visible, "Opening also requires cheese stock")
 var cheese_box = station.get_node("freezer_cheese")
 var cheese_eye := Vector3(9.2, 2.0, -10.05)
 assert(game.interaction_at(cheese_eye, cheese_eye.direction_to(cheese_box.global_position)).action == cheese_box, "Cheese box can be reached from the freezer aisle")
 shift.interact(cheese_box)
 assert(shift.carried_item == station.CHEESE_STOCK and not shift.place_carried())
 shift.interact(station.get_node("CheeseBin"))
 assert(shift.carried_item.is_empty() and station.cheese_stocked and station.cheese_ingredients.visible)
 assert(shift.start_shift())
 for target in [station.raw_tray,station.prep,station.grill]:
  game.player.position = Vector3(-1.5,0.03,target.global_position.z)
  game.camera.look_at(target.global_position)
  await physics_frame
  await physics_frame
  game._update_interaction()
  assert(game.target_action == target,"Burger targets reachable beside real flat top")
 station.use("burger_raw")
 assert(shift.carried_item == "Raw patty")
 assert(not shift.place_carried(),"Raw meat cannot enter serving tray")
 station.use("burger_prep")
 assert(shift.carried_item == "Raw patty", "Bun tray must reject raw meat")
 station.use("burger_grill")
 assert(station.cooking and shift.carried_item.is_empty() and station.audio.playing)
 station.tick(2)
 station.use("burger_grill")
 assert(station.flipped_at < 0)
 station.tick(1.1)
 station.use("burger_grill")
 assert(station.flipped_at >= 0)
 station.tick(3)
 assert(station.quality() == "ready")
 var saved = station.snapshot()
 station.reset()
 station.restore(saved)
 assert(station.quality() == "ready")
 station.use("burger_grill")
 assert(shift.carried_item == "Cooked patty" and not station.audio.playing)
 assert(not shift.place_carried(),"Patty needs bun")
 station.use("burger_raw")
 assert(shift.carried_item == "Cooked patty", "Raw tray must not assemble cooked food")
 station.use("burger_prep")
 assert(shift.carried_item == "Burger")
 for topping in ["Cheese", "Tomato", "Lettuce", "Onion"]:
  var bin = station.get_node(topping + "Bin")
  var origin = Vector3(-1.5, 2.0, bin.global_position.z)
  assert(game.interaction_at(origin, origin.direction_to(bin.global_position)).action == bin)
  if topping == "Onion":
   assert(shift.carried_item != "Deluxe burger", "Deluxe requires onion")
  shift.interact(bin)
  var dressed = shift.carried_item
  shift.interact(bin)
  assert(shift.carried_item == dressed, "A topping cannot be added twice")
 assert(shift.carried_item == "Deluxe burger")
 assert(shift.place_carried() and shift.tray == ["Deluxe burger"])
 shift.customer_line.nude_chance = 0
 var buyer = shift.customer_line.make_actor(Vector3(-2.4, -0.094, -3.6), "male_1")
 shift.customer_line.waiting.append({"actor": buyer, "seconds": 0.0, "junction": true})
 shift._spawn_customer()
 shift.phase = "waiting"
 shift.order.assign(["Deluxe burger"])
 shift.order_taken = true
 assert(shift.serve_order() and shift.earnings.sales == 10,"Correct burger order pays")
 shift.phase = "arriving"
 station.use("burger_raw")
 station.use("burger_grill")
 station.tick(13)
 assert(station.quality() == "burnt")
 station.use("burger_grill")
 assert(not station.cooking and shift.carried_item.is_empty())
 assert(preload("res://shift.gd").ORDERS.any(func(order):return "Burger" in order))
 assert(station.ingredient_groups.size() == 6)
 shift.begin_cleanup()
 for group in station.ingredient_groups:
  assert(not group.visible and group.get_parent().collision_layer == 0, "Closing clears ingredients and their pickup targets")
 shift.begin_prep(false)
 for group in station.ingredient_groups:
  assert(group.visible == (group not in [station.tomato_ingredients, station.onion_ingredients, station.lettuce_ingredients, station.cheese_ingredients]) and group.get_parent().collision_layer == 4, "Tomorrow starts with empty, targetable topping trays")
 print("PASS: physical flat top and prep targeting, raw pickup, two-sided cook, assembly, physical topping bins, deluxe serving/payment, burning, state restoration and burger orders")
 quit()
