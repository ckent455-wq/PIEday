extends SceneTree
func _initialize(): call_deferred("check")
func advance(shift, seconds: float):
	for i in range(int(seconds*60)): shift._process(1.0/60.0)
func check():
	root.set_meta("pie_day_wallet",preload("res://earnings.gd").new(false))
	var game=load("res://main.tscn").instantiate()
	root.add_child(game)
	game.set_physics_process(false)
	var shift=game.shift
	shift.set_process(false)
	var bathroom=game.find_child("Door",true,false)
	var kitchen=game.find_child("Door_01",true,false)
	var front=game.find_child("Door_03",true,false)
	assert(not bathroom.get_meta("open") and not kitchen.get_meta("open") and not front.get_meta("open"))
	shift.start_demo()
	shift.customer_line.next_arrival=INF
	advance(shift,.3)
	assert(front.get_meta("open") and shift.customer_line.front_door_auto_opened)
	assert(shift.customer.position.z > 4.5,"Customer waits for front door swing before passing")
	advance(shift,6)
	assert(shift.phase=="waiting" and not front.get_meta("open"),"Front door closes after arrival")
	assert(not bathroom.get_meta("open") and not kitchen.get_meta("open"))
	shift.begin_cleanup()
	advance(shift,10)
	assert(shift.customer_line.departing.is_empty() and not front.get_meta("open"),"Last departing customer closes the door")
	game._toggle_door(bathroom)
	assert(bathroom.get_meta("open"))
	game._toggle_door(bathroom)
	game._toggle_door(front)
	shift.customer_line.tick(.1)
	assert(front.get_meta("open"),"A door opened manually is left under player control")
	print("PASS: staff doors closed by default, player-operated bathroom, customer entry/exit door use, safe passage, automatic closure after final departure, manual state respected")
	quit()
